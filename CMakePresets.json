{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SHOWCUE_BUILD_IDE_INDEX": "ON",
        "SHOWCUE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
        "SHOWCUE_BUILD_IDE_INDEX": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS Debug",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-ci",
      "displayName": "macOS CI",
      "inherits": "ci-base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-vs-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vs2026",
      "hidden": true,
      "inherits": "windows-vs-base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-vs2022",
      "hidden": true,
      "inherits": "windows-vs-base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug (VS 2026)",
      "inherits": "windows-vs2026"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release (VS 2026)",
      "inherits": "windows-vs2026"
    },
    {
      "name": "windows-release-vs2022",
      "displayName": "Windows Release (VS 2022)",
      "inherits": "windows-vs2022"
    },
    {
      "name": "windows-ci",
      "displayName": "Windows CI",
      "inherits": "ci-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-debug",
      "displayName": "Build macOS Debug",
      "configurePreset": "macos-debug",
      "targets": ["ShowCue"]
    },
    {
      "name": "macos-release",
      "displayName": "Build macOS Release",
      "configurePreset": "macos-release",
      "targets": ["ShowCue"]
    },
    {
      "name": "macos-ci",
      "displayName": "Build macOS CI",
      "configurePreset": "macos-ci",
      "targets": ["ShowCue", "ShowCueTests"]
    },
    {
      "name": "windows-debug",
      "displayName": "Build Windows Debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "targets": ["ShowCue"]
    },
    {
      "name": "windows-release",
      "displayName": "Build Windows Release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "targets": ["ShowCue"]
    },
    {
      "name": "windows-release-vs2022",
      "displayName": "Build Windows Release (VS 2022)",
      "configurePreset": "windows-release-vs2022",
      "configuration": "Release",
      "targets": ["ShowCue"]
    },
    {
      "name": "windows-ci",
      "displayName": "Build Windows CI",
      "configurePreset": "windows-ci",
      "configuration": "Release",
      "targets": ["ShowCue", "ShowCueTests"]
    }
  ],
  "testPresets": [
    {
      "name": "macos-release",
      "displayName": "Test macOS Release",
      "configurePreset": "macos-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-ci",
      "displayName": "Test macOS CI",
      "configurePreset": "macos-ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "displayName": "Test Windows Release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ci",
      "displayName": "Test Windows CI",
      "configurePreset": "windows-ci",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
